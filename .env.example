# Required site metadata
ROOT_NOTION_PAGE_ID=
NAME=
DOMAIN=
AUTHOR=

# Optional site metadata
DESCRIPTION=
TITLE=
ROOT_NOTION_SPACE_ID=
BLOG_PAGE_ID=

# Optional social links
TWITTER=
GITHUB=
LINKEDIN=
YOUTUBE=
NEWSLETTER=

# Optional routing and navigation config
# JSON object mapping URL path to Notion page ID, for example:
# {"/about":"<notion-page-id>"}
PAGE_URL_OVERRIDES={}

# JSON object mapping additional URL path to a public Notion page ID
PAGE_URL_ADDITIONS={}

# "default" or "custom"
NAVIGATION_STYLE=default

# JSON array of links used when NAVIGATION_STYLE=custom, for example:
# [{"title":"Home","pageId":"<notion-page-id>"},{"title":"GitHub","url":"https://github.com/you"}]
NAVIGATION_LINKS=[]

# Optional rendering toggles
PREVIEW_IMAGE=
INCLUDE_NOTION_ID_IN_URLS=
SHOW_COLLECTION_VIEW_DROPDOWN=

# Optional deployment/runtime values
CRON_SECRET=

# Vercel Optimization
REVALIDATE_TTL=3600
# Upstash Redis (Vercel Integration usually provides one of these sets)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# OR (if using Vercel KV name scheme)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Deployment/Runtime Defaults
VERCEL_URL=
CRON_URL=

# Article audio / TTS (Local-only generation)
# Vercel only needs AUDIO_STORAGE_PROVIDER and BLOB_READ_WRITE_TOKEN to serve cached bundles.
AUDIO_STORAGE_PROVIDER=vercel-blob
BLOB_READ_WRITE_TOKEN=

# Local development only (Requires Apple Silicon Mac + Setup)
LOCAL_TTS_BACKEND=mlx-audio
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
KOKORO_WHISPERX_DEVICE=mps
