{
  "name": "nextjs-notion-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js website using Notion as CMS",
  "author": "Vivek Kaushik",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --apply .",
    "test": "npm run check",
    "audio:setup-kokoro": "bash ./scripts/setup-kokoro.sh",
    "audio:setup-kokoro-coreml": "LOCAL_TTS_BACKEND=kokoro-coreml bash ./scripts/setup-kokoro.sh",
    "audio:setup-mlx": "LOCAL_TTS_BACKEND=mlx-audio bash ./scripts/setup-kokoro.sh",
    "audio:generate": "bash ./scripts/generate-article-audio.sh"
  },
  "dependencies": {
    "@react-icons/all-files": "^4.1.0",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^1.2.2",
    "@vercel/blob": "^2.3.1",
    "@vercel/og": "^0.0.19",
    "@vercel/speed-insights": "^1.0.10",
    "mermaid": "^11.13.0",
    "next": "^16.1.6",
    "notion-client": "^7.8.2",
    "notion-types": "^7.8.2",
    "notion-utils": "^7.8.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-notion-x": "^7.8.2",
    "react-tweet-embed": "^2.0.0",
    "shiki": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.7.3",
    "@next/bundle-analyzer": "^12.3.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "postcss": "^8.5.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "cacheable-request": {
      "keyv": "npm:@keyvhq/core@~1.6.6"
    },
    "minimatch": "^10.2.2",
    "brace-expansion": "^2.0.1",
    "react": "$react",
    "react-dom": "$react-dom"
  }
}
